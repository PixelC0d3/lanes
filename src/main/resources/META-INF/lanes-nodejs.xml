<!--
  Optional module, wired from plugin.xml via <depends optional="true" config-file="lanes-nodejs.xml">JavaScript</depends>.
  It is loaded ONLY when the host IDE has the JavaScript plugin (WebStorm, IntelliJ IDEA Ultimate, ...).

  Contributes a Lanes "Env Files" section to the Node-based run configurations whose launch actually
  applies extensions: Node.js and npm/pnpm/yarn scripts. Running such an app directly with the IDE's
  own Play/Debug can load one or more .env files - the same capability a Lanes group already offers
  its children. Mocha/Karma/Jest run states never invoke the extension launch session, so the field
  is hidden there (see NodeEnvFileSettings.isLaunchInjectionSupported). See LanesNodeEnvFileExtension.
-->
<idea-plugin>
    <extensions defaultExtensionNs="JavaScript">
        <nodeRunConfigurationExtension
                implementation="io.github.pixelcodes.lanes.nodejs.LanesNodeEnvFileExtension"/>
    </extensions>
    <actions>
        <!-- toolbar button next to the run configuration selector: pick which .env profile the
             selected Node run configuration runs with next, once it has 2+ saved profiles -->
        <action id="Lanes.PickNodeEnvProfile" class="io.github.pixelcodes.lanes.nodejs.NodeEnvProfileToolbarAction"
                text="Env" description="Pick which .env profile the selected Node run configuration runs with next"
                icon="io.github.pixelcodes.lanes.LanesIcons.EnvVariables">
            <add-to-group group-id="ToolbarRunGroup" anchor="before" relative-to-action="RunnerActions"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="NewUiRunWidget"/>
        </action>
    </actions>
</idea-plugin>
